#!/bin/busybox sh
# PID 1 of the VM: mount the kernel's virtual file systems, then start a shell.
/bin/busybox --install -s /bin
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev
mount -t debugfs  debugfs  /sys/kernel/debug
mount -t tracefs  tracefs  /sys/kernel/tracing
echo "Linux $(uname -r) is up. Your files are in /root. Type exit to power off."
cd /root
setsid cttyhack sh
poweroff -f
