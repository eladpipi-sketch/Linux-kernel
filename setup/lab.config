# Lab options, merged on top of "make defconfig kvm_guest.config".
# Debug info: lets gdb and faddr2line turn addresses into source lines
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_GDB_SCRIPTS=y
# Tracing
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_DEBUG=y
# Bug detectors
CONFIG_KASAN=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_KMEMLEAK=y
# CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN is not set
# kmemleak stays off unless you boot with kmemleak=on (Day 18): it is slow
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=y
# PCI hot-plug from the QEMU monitor
CONFIG_HOTPLUG_PCI_ACPI=y
# USB in software: a host controller wired to a device controller, and
# gadgets (USB devices) you assemble from the shell through configfs
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_LB_SS=y
# /proc/config.gz shows the running kernel's configuration
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Short version strings: 7.3.0, or 7.3.0-dirty while the source has uncommitted changes
# CONFIG_LOCALVERSION_AUTO is not set
